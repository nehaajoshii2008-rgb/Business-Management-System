{
  "version": 2,
  "builds": [
    {
      "src": "isbms/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb", "runtime": "python3.11" }
    },
    {
      "src": "inventory/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/inventory/static/$1"
    },
    {
      "src": "(.*)",
      "dest": "isbms/wsgi.py"
    }
  ]
}
